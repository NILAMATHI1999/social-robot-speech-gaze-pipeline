+def smooth_gaze(history, raw_state):
+    if raw_state == "unknown":
+        history.clear()
+        return "unknown"
+
+    history.append(raw_state)
+
+    if history.count("yes") * 2 > len(history):
+        return "yes"
+
+    return "no"
